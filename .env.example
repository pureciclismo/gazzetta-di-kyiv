# ──────────────────────────────────────────────────────
# Gazzetta di Kyiv — Environment Variables
# ──────────────────────────────────────────────────────
# Copy to .env and fill in real values:
#   cp .env.example .env && chmod 600 .env
#
# The .env file is sourced by systemd (EnvironmentFile=)
# and by scripts that check os.environ.
# Keys are also stored in GCP Secret Manager for production.
# ──────────────────────────────────────────────────────

# DeepSeek API — contradiction analysis engine
# Get your key at: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-key-here

# Telegram — pipeline alerts and broadcast distribution
# Get your token from: @BotFather on Telegram
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_BROADCAST_CHAT_ID=-1003990434181
TELEGRAM_ADMIN_CHAT_ID=-1004455619334
# Internal home channel for agent notifications
_TCH=-1003796560949

# YouTube Data API v3 — Sovereign Vault collector
# Get your key at: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your-youtube-api-key

# SerpAPI — patent search (250 searches/month free tier)
# Get your key at: https://serpapi.com/manage-api-key
SERPAPI_API_KEY=your-serpapi-key

# AlphaVantage — market price fallback (free tier: 5 calls/min)
# Get your key at: https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=your-alphavantage-key

# CFTC Commitment of Traders — no key needed (public API)

# FRED — Federal Reserve Economic Data
# Get your key at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your-fred-api-key

# GCS Deployment
# Service account JSON key path for gsutil operations
# GOOGLE_APPLICATION_CREDENTIALS=/opt/gazzetta-di-kyiv/.gsutil/key.json

# Gmail Newsletter Harvester (OAuth 2.0)
# Generated by: python scripts/gmail_oauth_setup.py
# Then stored in GCP Secret Manager (not in .env directly)
# GMAIL_REFRESH_TOKEN=stored-in-secret-manager
# GMAIL_CLIENT_ID=stored-in-secret-manager
# GMAIL_CLIENT_SECRET=stored-in-secret-manager

# Optional: override default paths
# GAZZETTA_HOME=/opt/gazzetta-di-kyiv
# GAZZETTA_DB_PATH=/opt/gazzetta-di-kyiv/data/gazzetta.db
